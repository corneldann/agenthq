# AgentHQ Environment Configuration
#
# Copy this file to .env and fill in your engagement-specific paths.
# AgentHQ will read these variables at startup.

# Server Configuration
# --------------------

# PORT - HTTP server port (default: 3333)
PORT=3333

# Workspace and Output Paths
# ---------------------------

# OUTPUT_DIR - Root directory for agent output files (sessions, chains, etc.)
# Example: C:\path\to\your\engagement\docs\output
OUTPUT_DIR=

# SESSIONS_DIR - Directory where agent session .jsonl files are stored
# Example: C:\path\to\your\engagement\.sessions
SESSIONS_DIR=

# CHAINS_DIR - Directory where agent chain execution logs are stored
# Falls back to SESSIONS_DIR if not set
# Example: C:\path\to\your\engagement\.sessions
CHAINS_DIR=

# WORKFLOW_DIR - Directory where Kiro stores workflow execution files
# Falls back to %APPDATA%\Kiro\User\globalStorage\... if not set
# Example: C:\Users\YourName\AppData\Roaming\Kiro\User\globalStorage\kiro.kiroagent\...
WORKFLOW_DIR=

# WORKSPACE_ROOT - Root directory of the engagement workspace
# Example: C:\path\to\your\engagement
WORKSPACE_ROOT=

# SPECS_DIR - Directory where Kiro specs are stored
# Example: C:\path\to\your\engagement\.kiro\specs
SPECS_DIR=

# PROMPT_OUTPUT_DIR - Directory where prompt outputs are written
# Falls back to OUTPUT_DIR if not set
# Example: C:\path\to\your\engagement\docs\analysis\prompts\output
PROMPT_OUTPUT_DIR=

# Queue File Paths
# ----------------

# CRAWL_JOBS_FILE - Path to the crawl queue file (relative to WORKSPACE_ROOT)
# Default: docs/reference/.crawl-queue.json
CRAWL_JOBS_FILE=docs/reference/.crawl-queue.json

# CLONE_JOBS_FILE - Path to the clone queue file (relative to WORKSPACE_ROOT)
# Default: docs/reference/.clone-queue.json
CLONE_JOBS_FILE=docs/reference/.clone-queue.json

# BUILD_QUEUE_FILE - Path to the build queue file (relative to WORKSPACE_ROOT)
# Default: docs/reference/.build-queue.json
BUILD_QUEUE_FILE=docs/reference/.build-queue.json

# Tool Paths
# ----------

# KIRO_TOOLS_DIR - Directory where Kiro tools are installed
# Example: C:\tools\kiro
KIRO_TOOLS_DIR=

# Database Configuration
# ----------------------

# DB_ENABLED - Enable the database layer (default: true)
# Accepts "true" or "false" only (case-insensitive). Any other value aborts startup.
DB_ENABLED=true

# DB_TYPE - Database engine to use: "sqlite" or "postgres" (default: sqlite)
DB_TYPE=sqlite

# DB_PATH - Path to the SQLite database file (default: .agenthq.db)
# Only used when DB_TYPE=sqlite.
# Example: C:\path\to\your\engagement\.agenthq.db
DB_PATH=.agenthq.db

# DB_URL - PostgreSQL connection URL (required when DB_TYPE=postgres)
# Format: postgres://user:password@host:port/database
# Example: postgres://agenthq:secret@localhost:5432/agenthq
DB_URL=

# WebSocket Configuration
# -----------------------

# WS_ENABLED - Enable the WebSocket layer (default: true)
# Any value other than "false" enables WebSocket. Set to "false" to disable.
WS_ENABLED=true

# WS_IDLE_TIMEOUT - Idle connection timeout in seconds (range: 10-300, default: 30)
# Connections with no messages (ping/pong or data) for this many seconds are closed.
# Values outside the range are clamped to the nearest boundary with a warning.
WS_IDLE_TIMEOUT=30

# WS_MAX_MESSAGE_SIZE - Maximum inbound message size in bytes (range: 1024-10485760, default: 1048576)
# Messages larger than this value receive an error response (code 413) and are dropped.
# Default is 1 MB (1048576 bytes). Maximum is 10 MB (10485760 bytes).
# Values outside the range are clamped to the nearest boundary with a warning.
WS_MAX_MESSAGE_SIZE=1048576

# Memory Configuration (Phase 6.1)
# ----------------------------------

# MEMORY_ENABLED - Enable the memory layer (default: false)
# When false, all memory operations are no-ops and no connection to Hindsight is made.
# Set to "true" to enable memory retention, recall, and reflection features.
MEMORY_ENABLED=false

# HINDSIGHT_URL - Base URL for the Hindsight MCP memory server (default: http://localhost:3100)
# The adapter sends HTTP POST requests to {HINDSIGHT_URL}/mcp for all memory operations.
HINDSIGHT_URL=http://localhost:3100

# MEMORY_EXTRACTION_ENABLED - Enable automatic memory extraction from agent output (default: false)
# Can be disabled independently of MEMORY_ENABLED. Requires MEMORY_ENABLED=true to have any effect.
MEMORY_EXTRACTION_ENABLED=false

# MEMORY_AUTO_INJECT - Enable automatic memory injection into agent prompts (default: false)
# When true, recalled memories are prepended to prompts during context assembly.
MEMORY_AUTO_INJECT=false

# MEMORY_MAX_CONTEXT_MEMORIES - Maximum number of memories injected per prompt (default: 10)
# Parsed as an integer. Controls the upper bound on recalled memories during context assembly.
MEMORY_MAX_CONTEXT_MEMORIES=10

# MEMORY_CONTEXT_TOKEN_BUDGET - Token budget for injected memories per prompt (default: 2000)
# Parsed as an integer. Memory injection stops when the accumulated token estimate exceeds this value.
MEMORY_CONTEXT_TOKEN_BUDGET=2000

# MEMORY_DECAY_DAYS - Staleness window for memory decay in days (default: 90)
# Parsed as an integer. Memories not retrieved within this window are candidates for decay.
MEMORY_DECAY_DAYS=90

# MEMORY_RETRY_PATH - Path to the JSONL retry queue file for failed memory writes (default: data/memory-retry-queue.jsonl)
# Failed retain() calls are queued here and retried every 5 minutes by the memoryRetry worker.
MEMORY_RETRY_PATH=data/memory-retry-queue.jsonl

# VOYAGE_API_KEY - API key for the Voyage AI embedding service (default: empty string)
# Required for hot-tier real-time embedding via the voyage-3-large model.
# If absent and MEMORY_ENABLED=true, AgentHQ logs a warning at startup and falls back to
# Hindsight's internal embedding (applied on first recall). Cold-tier batch embedding also
# requires this key for the Voyage Batch API to function.
# Get your key at https://dash.voyageai.com/
VOYAGE_API_KEY=

# MEMORY_HOT_TIER_COUNT - Number of recently-completed jobs that qualify for hot-tier embedding (default: 100)
# Parsed as an integer. Jobs within the most-recent N completed jobs are embedded immediately
# via the Voyage real-time API; all older jobs are queued as cold-tier for the 6-hour batch worker.
# Increase this value to grow the set of immediately-searchable memories at the cost of more
# real-time Voyage API calls. Reducing it shifts more work to the cheaper batch endpoint.
MEMORY_HOT_TIER_COUNT=100
